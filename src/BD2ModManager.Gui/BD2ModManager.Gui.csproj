<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BD2ModManager.Gui</RootNamespace>
    <AssemblyName>BD2ModManager</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BD2ModManager.Core\BD2ModManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\logo.png" />
  </ItemGroup>

  <!--
    loader 包在构建时嵌入 exe，发布出来就是一个自包含单文件，用户下载即用。
    文件不存在时跳过（本地开发阶段不打包也能编译运行）。
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\bd2-loader.zip"
                      LogicalName="bd2-loader.zip"
                      Condition="Exists('Assets\bd2-loader.zip')" />

    <!-- 自研解锁插件：构建时拷进 Assets，随 exe 一起发出去，用户点一下就装 -->
    <EmbeddedResource Include="Assets\BD2SkinUnlock.dll"
                      LogicalName="BD2SkinUnlock.dll"
                      Condition="Exists('Assets\BD2SkinUnlock.dll')" />
  </ItemGroup>

</Project>
