<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BD2ModManager.Gui"
        xmlns:controls="using:BD2ModManager.Gui.Controls"
        x:Class="BD2ModManager.Gui.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="BD2ModManager"
        Width="840" Height="520"
        MinWidth="760" MinHeight="480"
        CanResize="True"
        SystemDecorations="None"
        Background="{StaticResource WindowBg}"
        TransparencyLevelHint="None"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="48,*">

    <!-- ============ 标题栏 ============ -->
    <Border Grid.Row="0" Background="#FAFAFA"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
            PointerPressed="TitleBar_PointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0,12,0">
        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                Background="{StaticResource AccentBrush}" ClipToBounds="True"
                VerticalAlignment="Center">
          <Image Source="/Assets/logo.png" Stretch="UniformToFill" />
        </Border>

        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimary}" />
          <TextBlock Text="棕色尘埃2 · 本地显示管理" FontSize="10.5"
                     Foreground="{StaticResource TextMuted}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <Border Classes="badge" Padding="10,4" VerticalAlignment="Center">
            <TextBlock Text="{Binding Version}" FontSize="10.5"
                       FontFamily="Cascadia Mono, Consolas, monospace"
                       Foreground="{StaticResource AccentBrush}" />
          </Border>
          <Button Classes="window-control" Click="Minimize_Click" ToolTip.Tip="最小化">
            <Border Width="12" Height="1.5" CornerRadius="1"
                    Background="{StaticResource TextMuted}" />
          </Button>
          <Button Classes="window-control window-close" Click="Close_Click" ToolTip.Tip="关闭">
            <Path Data="M6 6L18 18M18 6L6 18"
                  Stroke="{StaticResource TextMuted}"
                  StrokeThickness="1.5" StrokeLineCap="Round"
                  Width="14" Height="14" Stretch="Uniform" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ 主体 ============ -->
    <Grid Grid.Row="1" ColumnDefinitions="220,*">

      <!-- 侧栏 -->
      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Margin="14,24,14,0" Spacing="4">
            <TextBlock Text="导航" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                       Margin="10,0,0,8" />
            <Button Classes="nav active">
              <Grid ColumnDefinitions="20,*">
                <Path Data="M3 3H10V10H3Z M14 3H21V10H14Z M3 14H10V21H3Z M14 14H21V21H14Z"
                      Fill="Transparent" Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform"
                      VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="总览" Margin="9,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="nav" Command="{Binding OpenPathSheetCommand}">
              <Grid ColumnDefinitions="20,*">
                <Path Data="M3 6.5C3 5.7 3.7 5 4.5 5H9L11 7H19.5C20.3 7 21 7.7 21 8.5V18.5C21 19.3 20.3 20 19.5 20H4.5C3.7 20 3 19.3 3 18.5V6.5Z"
                      Fill="Transparent" Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform"
                      VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="游戏与 Loader" Margin="9,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="nav" Command="{Binding OpenModulesCommand}">
              <Grid ColumnDefinitions="20,*">
                <Path Data="M4 4H10V10H4Z M14 4H20V10H14Z M4 14H10V20H4Z M14 14H20V20H14Z"
                      Fill="Transparent" Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform"
                      VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="解锁模块" Margin="9,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="nav" Command="{Binding OpenLogsSheetCommand}">
              <Grid ColumnDefinitions="20,*">
                <Path Data="M4 4H20V20H4Z M7 8H17 M7 12H17 M7 16H13"
                      Fill="Transparent" Stroke="{Binding $parent[Button].Foreground}"
                      StrokeThickness="1.3" Width="15" Height="15" Stretch="Uniform"
                      VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="诊断与日志" Margin="9,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>

          <Border Grid.Row="2" Margin="14,0,14,18" Padding="12,10"
                  Background="White" BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="10">
            <StackPanel Spacing="2">
              <TextBlock Text="当前版本" FontSize="9.5" Foreground="{StaticResource TextMuted}" />
              <TextBlock Text="{Binding Version}" FontSize="15" FontWeight="SemiBold"
                         FontFamily="Cascadia Mono, Consolas, monospace" />
              <TextBlock Text="{Binding PluginVersionText}" FontSize="9.5"
                         Foreground="{StaticResource TextMuted}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- 内容 -->
      <ScrollViewer Grid.Column="1" x:Name="ContentScroll"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalContentAlignment="Stretch"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentPanel" Margin="32,26,32,28" Spacing="20"
                    HorizontalAlignment="Stretch">

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="总览" Classes="page-title" />
              <TextBlock Text="管理游戏目录、Loader 与本地显示模块。" Classes="page-subtitle" />
            </StackPanel>
            <Border Grid.Column="1" Classes="badge" VerticalAlignment="Top" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                         VerticalAlignment="Center" />
                <TextBlock Text="本地模式" FontSize="10.5" Foreground="{StaticResource SuccessBrush}" />
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel Spacing="16">
            <!-- 一键启用 -->
            <Border Classes="card" Padding="26">
              <Grid ColumnDefinitions="132,*" ColumnSpacing="16">
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9">
                  <TextBlock Text="一键启用" Classes="section-title" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="9" Height="9" Fill="{Binding HeroDotBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HeroTitle}" FontSize="24" FontWeight="Bold"
                               TextWrapping="Wrap" MaxWidth="250" />
                  </StackPanel>
                  <TextBlock Text="{Binding HeroHint}" FontSize="11.5"
                             IsVisible="{Binding ShowHeroHint}"
                             Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding StatusText}" FontSize="11"
                             Foreground="{StaticResource TextSecondary}" />
                  <Border Background="#F8F8F8" BorderBrush="#EDEDED" BorderThickness="1"
                          CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                    <TextBlock Text="{Binding GamePath}" FontSize="10.5"
                               Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding GamePath}" />
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Classes="primary" Content="打开游戏目录"
                            Command="{Binding OpenGameFolderCommand}"
                            IsEnabled="{Binding HasGame}" />
                    <Button Classes="ghost" Content="游戏位置"
                            Command="{Binding OpenPathSheetCommand}" />
                  </StackPanel>
                </StackPanel>

                <Grid Grid.Column="0" Width="132" Height="132"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Ellipse Width="128" Height="128" Fill="#F5F9FF" />
                  <Ellipse Width="108" Height="108" Stroke="#E1EFFB" StrokeThickness="2" />
                  <controls:LoadingSpinner x:Name="LoadingRing" Width="108" Height="108"
                                           IsVisible="{Binding IsBusy}" />
                  <Button Classes="power" Command="{Binding ToggleCommand}"
                          Focusable="False" IsEnabled="{Binding CanToggle}"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="86" Height="86" CornerRadius="43"
                            Background="{Binding PowerBackground}">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
                        <Path Data="M12 2L12 12 M7.05 5.64 A7 7 0 1 0 16.95 5.64"
                              Fill="Transparent" Stroke="{Binding PowerTextBrush}"
                              StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                              Width="22" Height="22" Stretch="Uniform" />
                        <TextBlock Text="{Binding PowerLabel}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{Binding PowerTextBrush}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Button>
                </Grid>
              </Grid>
            </Border>

            <!-- 模块状态 -->
            <Border Classes="card">
              <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="模块状态" Classes="section-title" />
                  <Button Grid.Column="1" Classes="link" Content="管理"
                          Command="{Binding OpenModulesCommand}"
                          IsEnabled="{Binding CanOpenModules}" />
                </Grid>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding ModuleStatuses}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModuleStatusRow">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,7">
                        <Ellipse Width="7" Height="7" Fill="{Binding Brush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                   Foreground="{StaticResource TextPrimary}" Margin="9,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="10.5"
                                   Foreground="{Binding Brush}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Spacing="16">
            <!-- 最近操作 -->
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="最近一次操作" Classes="section-title" />
                <TextBlock Text="{Binding UpdateStatus}" FontSize="12"
                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PluginUpdateStatus}" FontSize="11"
                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                  <Button Classes="primary" Content="检查更新"
                          Command="{Binding CheckUpdateCommand}"
                          IsEnabled="{Binding !IsCheckingUpdate}" />
                  <Button Classes="ghost" Content="打开日志"
                          Command="{Binding OpenLogsSheetCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 诊断包 -->
            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Text="诊断包" Classes="section-title" />
                <TextBlock Text="版本、Loader、插件、配置与日志末尾，自动脱敏。"
                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                  <Button Classes="primary" Content="导出诊断包"
                          Command="{Binding ExportDiagnosticsCommand}"
                          IsEnabled="{Binding CanExportDiagnostics}" />
                  <Button Classes="ghost" Content="清理残留"
                          Command="{Binding CleanResidueCommand}"
                          IsVisible="{Binding ShowCleanResidue}"
                          IsEnabled="{Binding CanCleanResidue}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Classes="card" Padding="18,14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="插件独立更新" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="主程序不必因插件小改而整包重下，下载后校验 SHA256 再替换。"
                           FontSize="10.5" Foreground="{StaticResource TextMuted}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                          VerticalAlignment="Center">
                <Button Classes="ghost" Content="检查插件更新"
                        Command="{Binding CheckPluginUpdateCommand}"
                        IsEnabled="{Binding !IsInstallingPluginUpdate}" />
                <Button Classes="primary" Content="{Binding PluginUpdateButtonText}"
                        Command="{Binding InstallPluginUpdateCommand}"
                        IsVisible="{Binding CanInstallPluginUpdate}" />
              </StackPanel>
            </Grid>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- 轻量操作反馈 -->
    <Border Grid.RowSpan="2" ZIndex="150" IsVisible="{Binding ToastVisible}"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,64,0,0"
            Background="#F8FBFF" BorderBrush="{StaticResource BlueBorder}" BorderThickness="1"
            CornerRadius="10" Padding="12,7"
            IsHitTestVisible="False">
      <TextBlock Text="{Binding ToastText}" FontSize="11"
                 Foreground="{StaticResource AccentBrush}" />
    </Border>

    <!-- ============ 抽屉/弹窗 ============ -->
    <Border Grid.RowSpan="2" IsVisible="{Binding IsAnySheetOpen}" Background="#660F172A" ZIndex="50">
      <Grid>
        <Button Background="Transparent" BorderThickness="0" Padding="0"
                Command="{Binding CloseSheetCommand}"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                Cursor="Arrow" />

        <!-- 游戏位置与环境 -->
        <Border IsVisible="{Binding PathSheetOpen}"
                Width="780" MaxHeight="470" Classes="dialog" Padding="26"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="36" Height="36" CornerRadius="10"
                        Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                  <Path Data="M3 6.5C3 5.7 3.7 5 4.5 5H9L11 7H19.5C20.3 7 21 7.7 21 8.5V18.5C21 19.3 20.3 20 19.5 20H4.5C3.7 20 3 19.3 3 18.5V6.5Z"
                        Fill="Transparent" Stroke="{StaticResource AccentBrush}"
                        StrokeThickness="1.5" StrokeJoin="Round"
                        Width="18" Height="18" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="sheet-title" Text="游戏位置与环境" />
                  <TextBlock Classes="page-subtitle" Text="管理游戏目录、Loader 与本地显示模块。" />
                </StackPanel>
                <Button Grid.Column="2" Classes="icon" Command="{Binding CloseSheetCommand}"
                        ToolTip.Tip="关闭">
                  <Path Data="M6 6L18 18 M18 6L6 18"
                        Fill="Transparent" Stroke="{StaticResource TextMuted}"
                        StrokeThickness="1.6" StrokeLineCap="Round"
                        Width="14" Height="14" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
              </Grid>

              <Border Classes="section">
                <StackPanel Spacing="8">
                  <TextBlock Classes="section-heading" Text="当前游戏目录" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{Binding GamePath}" Classes="mono"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding GamePath}" />
                    <Button Grid.Column="1" Classes="link" Content="复制" Click="CopyPath_Click" />
                  </Grid>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Classes="ghost" Content="重新检测"
                        Command="{Binding RescanCommand}" />
                <Button Grid.Column="1" Classes="ghost" Content="选择目录"
                        Command="{Binding BrowseCommand}" />
                <Button Grid.Column="2" Classes="ghost" Content="打开目录"
                        Command="{Binding OpenGameFolderCommand}"
                        IsEnabled="{Binding HasGame}" />
              </Grid>

              <Border Classes="section">
                <StackPanel Spacing="6">
                  <TextBlock Classes="section-heading" Text="运行状态" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock Text="{Binding StatusHint}" FontSize="11"
                             Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding GameMeta}" FontSize="10.5"
                             Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="section">
                <StackPanel Spacing="11">
                  <TextBlock Classes="section-heading" Text="更新" />

                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="主程序更新" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding UpdateStatus}" FontSize="10.5"
                                 Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                      <Button Classes="link" Content="检查" Command="{Binding CheckUpdateCommand}"
                              IsEnabled="{Binding !IsCheckingUpdate}" />
                      <Button Classes="link" Content="立即更新" Command="{Binding InstallUpdateCommand}"
                              IsVisible="{Binding CanAutoUpdate}" />
                      <Button Classes="link" Content="手动下载" Command="{Binding OpenUpdateCommand}"
                              IsVisible="{Binding UpdateAvailable}"
                              IsEnabled="{Binding !IsInstallingUpdate}" />
                    </StackPanel>
                  </Grid>

                  <Border Height="1" Background="{StaticResource CardBorder}" />

                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="插件更新" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding PluginUpdateStatus}" FontSize="10.5"
                                 Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                      <Button Classes="link" Content="检查" Command="{Binding CheckPluginUpdateCommand}"
                              IsEnabled="{Binding !IsInstallingPluginUpdate}" />
                      <Button Classes="link" Content="{Binding PluginUpdateButtonText}"
                              Command="{Binding InstallPluginUpdateCommand}"
                              IsVisible="{Binding CanInstallPluginUpdate}" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding UpdateDownloadDirText}" FontSize="9.5"
                               Foreground="{StaticResource TextMuted}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="link" Content="更新目录"
                            Command="{Binding PickUpdateDirCommand}"
                            IsEnabled="{Binding !IsInstallingUpdate}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Button Classes="ghost" Content="清理残留" HorizontalAlignment="Left"
                        Command="{Binding CleanResidueCommand}"
                        IsVisible="{Binding ShowCleanResidue}"
                        IsEnabled="{Binding CanCleanResidue}" />
                <Button Grid.Column="1" Classes="link" Content="功能模块"
                        Command="{Binding OpenModulesCommand}"
                        IsEnabled="{Binding CanOpenModules}"
                        ToolTip.Tip="开关皮肤、互动、审查、诊断与高风险本地镜像模块" />
                <Button Grid.Column="2" Classes="link" Content="导出诊断包" HorizontalAlignment="Right"
                        Command="{Binding ExportDiagnosticsCommand}"
                        IsEnabled="{Binding CanExportDiagnostics}"
                        ToolTip.Tip="打包版本、loader、插件、配置与日志末尾，便于反馈问题" />
              </Grid>

              <Border IsVisible="{Binding ShowPickPackage}"
                      Background="#FFF8F1" BorderBrush="#F3D6BC" BorderThickness="1"
                      CornerRadius="10" Padding="14,12">
                <StackPanel Spacing="6">
                  <TextBlock Text="缺少加载器包" FontSize="12.5" FontWeight="SemiBold" />
                  <TextBlock Text="当前构建没有内嵌 bd2-loader.zip。" FontSize="11"
                             Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                  <Button Classes="ghost" Content="选择加载器包" HorizontalAlignment="Left"
                          Command="{Binding PickPackageCommand}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- 日志 -->
        <Border IsVisible="{Binding LogsSheetOpen}"
                Width="780" Height="470" Classes="dialog" Padding="26"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Width="36" Height="36" CornerRadius="10"
                      Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                <Path Data="M4 5H20V19H4V5Z M7 9L10 12L7 15 M12 15H17"
                      Fill="Transparent" Stroke="{StaticResource AccentBrush}"
                      StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="18" Height="18" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="sheet-title" Text="运行日志" />
                <TextBlock Classes="page-subtitle" Text="记录安装、模块与更新操作；仅保留本次会话。" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="ghost" Content="清空" Command="{Binding ClearLogCommand}" />
                <Button Classes="icon" Command="{Binding CloseSheetCommand}" ToolTip.Tip="关闭">
                  <Path Data="M6 6L18 18 M18 6L6 18"
                        Fill="Transparent" Stroke="{StaticResource TextMuted}"
                        StrokeThickness="1.6" StrokeLineCap="Round"
                        Width="14" Height="14" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
              </StackPanel>
            </Grid>

            <Border Grid.Row="1" Classes="section" Margin="0,16,0,0" Padding="10">
              <ListBox x:Name="LogList" Classes="log-list" Height="320"
                       ItemsSource="{Binding LogLines}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="18" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- 确认浮层 -->
    <Border Grid.RowSpan="2" ZIndex="100"
            IsVisible="{Binding ConfirmVisible}" Background="#660F172A">
      <Border Classes="dialog" Width="420" Padding="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="20" Background="#FFF4E5"
                    VerticalAlignment="Top">
              <TextBlock Text="!" FontSize="20" FontWeight="Bold" Foreground="#B45309"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="5">
              <TextBlock Text="{Binding ConfirmTitle}" FontSize="16" FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding ConfirmMessage}" FontSize="12"
                         Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                         LineHeight="19" />
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="ghost" Content="取消" Command="{Binding ConfirmCancelCommand}" />
            <Button Classes="primary" Content="确认" Command="{Binding ConfirmYesCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</Window>
