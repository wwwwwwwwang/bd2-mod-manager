<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BD2ModManager.Gui"
        x:Class="BD2ModManager.Gui.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="BD2ModManager"
        Width="380" Height="460"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen">

  <Grid>

    <!-- ============ 主卡片 ============ -->
    <Border Margin="20"
            CornerRadius="28"
            Background="{StaticResource ShellGradient}"
            BorderBrush="#D9E8FB"
            BorderThickness="1">

      <Grid RowDefinitions="Auto,*,Auto">

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Height="62" Margin="18,8,10,0"
              Background="Transparent"
              PointerPressed="TitleBar_PointerPressed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="34" Height="34" CornerRadius="11"
                  Background="Transparent" ClipToBounds="True"
                  VerticalAlignment="Center">
            <Image Source="/Assets/logo.png" Stretch="UniformToFill" />
          </Border>

          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                         Foreground="{StaticResource TextPrimary}" />
              <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                      CornerRadius="8" Padding="6,1" VerticalAlignment="Center"
                      ToolTip.Tip="{Binding UpdateStatus}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Version}" FontSize="9.5"
                             FontFamily="Cascadia Mono, Consolas, monospace"
                             Foreground="{StaticResource AccentBrush}" />
                  <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding UpdateAvailable}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}" FontSize="10"
                       Foreground="{StaticResource TextMuted}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1"
                      VerticalAlignment="Top" Margin="0,2,0,0">
            <Button Classes="window-control" Click="Minimize_Click" ToolTip.Tip="最小化">
              <Path Data="M5 12H19"
                    Stroke="{StaticResource TextMuted}"
                    StrokeThickness="1.5" StrokeLineCap="Round"
                    Width="14" Height="14" Stretch="Uniform" />
            </Button>
            <Button Classes="window-control window-close" Click="Close_Click" ToolTip.Tip="关闭">
              <Path Data="M6 6L18 18M18 6L6 18"
                    Stroke="{StaticResource TextMuted}"
                    StrokeThickness="1.5" StrokeLineCap="Round"
                    Width="14" Height="14" Stretch="Uniform" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- 中央开关与状态 -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">

          <Grid Width="196" Height="196" HorizontalAlignment="Center">
            <!-- 柔和外圈 -->
            <Ellipse Width="190" Height="190" Fill="#EFF6FF" Opacity="0.8"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse Width="164" Height="164" Stroke="#DBEAFE" StrokeThickness="1"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- 静态轨道 -->
            <Arc Width="164" Height="164"
                 StartAngle="-90" SweepAngle="360"
                 Stroke="#BFDBFE" StrokeThickness="4"
                 StrokeLineCap="Round"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding !IsBusy}" />

            <!-- 加载旋转弧 -->
            <Arc x:Name="LoadingArc"
                 Width="164" Height="164"
                 StartAngle="-90" SweepAngle="80"
                 Stroke="{StaticResource AccentBrush}" StrokeThickness="4"
                 StrokeLineCap="Round"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding IsBusy}">
              <Arc.RenderTransform>
                <RotateTransform CenterX="82" CenterY="82" />
              </Arc.RenderTransform>
            </Arc>

            <Button Classes="power"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Command="{Binding ToggleCommand}"
                    IsEnabled="{Binding CanToggle}">
              <Border Width="112" Height="112" CornerRadius="56"
                      Background="{StaticResource PowerGradient}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                  <Path Data="M12 2L12 12 M7.05 5.64 A7 7 0 1 0 16.95 5.64"
                        Fill="Transparent"
                        Stroke="White" StrokeThickness="2.2"
                        StrokeLineCap="Round" StrokeJoin="Round"
                        Width="28" Height="28" Stretch="Uniform" />
                  <TextBlock Text="{Binding PowerLabel}"
                             FontSize="11.5" FontWeight="SemiBold"
                             Foreground="White" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </Button>
          </Grid>

          <StackPanel Spacing="6" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
              <Ellipse Width="8" Height="8" Fill="{Binding HeroDotBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding HeroTitle}" FontSize="14" FontWeight="Bold"
                         Foreground="{StaticResource TextPrimary}" />
            </StackPanel>
            <TextBlock Text="{Binding HeroHint}" FontSize="11"
                       Foreground="{StaticResource TextSecondary}"
                       TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="270" />
          </StackPanel>
        </StackPanel>

        <!-- 底部胶囊 -->
        <StackPanel Grid.Row="2" Margin="18,0,18,14" Spacing="10">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Classes="pill"
                    Command="{Binding OpenPathSheetCommand}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Data="M3 6.5C3 5.7 3.7 5 4.5 5H9L11 7H19.5C20.3 7 21 7.7 21 8.5V18.5C21 19.3 20.3 20 19.5 20H4.5C3.7 20 3 19.3 3 18.5V6.5Z"
                      Fill="Transparent" Stroke="{StaticResource AccentBrush}"
                      StrokeThickness="1.5" StrokeJoin="Round"
                      Width="14" Height="14" Stretch="Uniform"
                      VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="目录与环境" Margin="7,0,0,0"
                           FontSize="11.5" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <Path Grid.Column="2" Data="M9 18L15 12L9 6"
                      Fill="Transparent" Stroke="{StaticResource TextMuted}"
                      StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="12" Height="12" Stretch="Uniform"
                      Margin="6,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Button Grid.Column="1" Classes="pill"
                    Command="{Binding OpenLogsSheetCommand}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Data="M4 5H20V19H4V5Z M7 9L10 12L7 15 M12 15H17"
                      Fill="Transparent" Stroke="{StaticResource AccentBrush}"
                      StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="14" Height="14" Stretch="Uniform"
                      VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                            Margin="7,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="日志" FontSize="11.5" VerticalAlignment="Center"
                             TextWrapping="NoWrap" />
                  <Border MinWidth="16" Height="16" CornerRadius="8"
                          Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                          Padding="4,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LogCountText}" FontSize="9"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               Foreground="{StaticResource AccentBrush}" />
                  </Border>
                </StackPanel>
                <Path Grid.Column="2" Data="M9 18L15 12L9 6"
                      Fill="Transparent" Stroke="{StaticResource TextMuted}"
                      StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="12" Height="12" Stretch="Uniform"
                      Margin="6,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </Grid>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
            <Path Data="M12 2L20 6V12C20 17 16 20 12 22C8 20 4 17 4 12V6L12 2Z M8 12L11 15L16 9"
                  Fill="Transparent" Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="13" Height="13" Stretch="Uniform" />
            <TextBlock Text="关闭开关即还原，不修改游戏本体文件"
                       FontSize="9.5" Foreground="{StaticResource TextMuted}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ 抽屉遮罩与面板 ============ -->
    <Border Margin="20" IsVisible="{Binding IsAnySheetOpen}"
            CornerRadius="28" ClipToBounds="True" ZIndex="50">
      <Grid>
      <Button Background="#330F172A" BorderThickness="0" Padding="0"
              Command="{Binding CloseSheetCommand}"
              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
              Cursor="Arrow" />

      <!-- 目录与环境 -->
      <Border IsVisible="{Binding PathSheetOpen}"
              VerticalAlignment="Bottom"
              Background="White"
              BorderBrush="#DBEAFE" BorderThickness="1,0,1,0"
              CornerRadius="26,26,0,0"
              Padding="18,12,18,18">
        <StackPanel Spacing="11">
          <Border Width="36" Height="4" CornerRadius="2" Background="#E2E8F0"
                  HorizontalAlignment="Center" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Data="M3 6.5C3 5.7 3.7 5 4.5 5H9L11 7H19.5C20.3 7 21 7.7 21 8.5V18.5C21 19.3 20.3 20 19.5 20H4.5C3.7 20 3 19.3 3 18.5V6.5Z"
                  Fill="Transparent" Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="1.5" StrokeJoin="Round"
                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="游戏位置与环境" Margin="7,0,0,0"
                       FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="link" Content="关闭"
                    Command="{Binding CloseSheetCommand}" />
          </Grid>

          <Border Background="#F8FBFF" BorderBrush="#E2E8F0" BorderThickness="1"
                  CornerRadius="10" Padding="9,7">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding GamePath}" FontSize="10.5"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         ToolTip.Tip="{Binding GamePath}" />
              <Button Grid.Column="1" Classes="link" Content="复制" Click="CopyPath_Click" />
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Classes="ghost" Content="重新检测"
                    Command="{Binding RescanCommand}" />
            <Button Grid.Column="1" Classes="ghost" Content="选择目录"
                    Command="{Binding BrowseCommand}" />
            <Button Grid.Column="2" Classes="ghost" Content="打开目录"
                    Command="{Binding OpenGameFolderCommand}"
                    IsEnabled="{Binding HasGame}" />
          </Grid>

          <Border Background="#F8FBFF" BorderBrush="#DBEAFE" BorderThickness="1"
                  CornerRadius="10" Padding="10,8">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Text="{Binding StatusHint}" FontSize="10"
                         Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding GameMeta}" FontSize="9.5"
                         Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Background="#F8FBFF" BorderBrush="#DBEAFE" BorderThickness="1"
                  CornerRadius="10" Padding="10,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="更新检查" FontSize="10.5" FontWeight="SemiBold" />
                <TextBlock Text="{Binding UpdateStatus}" FontSize="9.5"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                          VerticalAlignment="Center">
                <Button Classes="link" Content="检查"
                        Command="{Binding CheckUpdateCommand}"
                        IsEnabled="{Binding !IsCheckingUpdate}" />
                <Button Classes="link" Content="下载"
                        Command="{Binding OpenUpdateCommand}"
                        IsVisible="{Binding UpdateAvailable}" />
              </StackPanel>
            </Grid>
          </Border>

          <Button Classes="ghost" Content="清理残留" HorizontalAlignment="Left"
                  Command="{Binding CleanResidueCommand}"
                  IsVisible="{Binding ShowCleanResidue}"
                  IsEnabled="{Binding CanCleanResidue}" />

          <Border IsVisible="{Binding ShowPickPackage}"
                  Background="#FFF8F1" BorderBrush="#F3D6BC" BorderThickness="1"
                  CornerRadius="10" Padding="10,8">
            <StackPanel Spacing="5">
              <TextBlock Text="缺少加载器包" FontSize="11.5" FontWeight="SemiBold" />
              <TextBlock Text="当前构建没有内嵌 bd2-loader.zip。" FontSize="10"
                         Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
              <Button Classes="ghost" Content="选择加载器包" HorizontalAlignment="Left"
                      Command="{Binding PickPackageCommand}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- 日志 -->
      <Border IsVisible="{Binding LogsSheetOpen}"
              VerticalAlignment="Bottom"
              Background="White"
              BorderBrush="#DBEAFE" BorderThickness="1,0,1,0"
              CornerRadius="26,26,0,0"
              Padding="18,12,18,16">
        <StackPanel Spacing="9">
          <Border Width="36" Height="4" CornerRadius="2" Background="#E2E8F0"
                  HorizontalAlignment="Center" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Data="M4 5H20V19H4V5Z M7 9L10 12L7 15 M12 15H17"
                  Fill="Transparent" Stroke="{StaticResource AccentBrush}"
                  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="运行日志" Margin="7,0,0,0"
                       FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <Button Classes="link" Content="清空" Command="{Binding ClearLogCommand}" />
              <Button Classes="link" Content="关闭" Command="{Binding CloseSheetCommand}" />
            </StackPanel>
          </Grid>

          <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                  CornerRadius="10" Padding="8,6">
            <ListBox x:Name="LogList" Classes="log-list" Height="216"
                     ItemsSource="{Binding LogLines}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="18" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </StackPanel>
      </Border>
      </Grid>
    </Border>

    <!-- ============ 确认浮层 ============ -->
    <Border ZIndex="100"
            IsVisible="{Binding ConfirmVisible}" Background="#660F172A">
      <Border Background="White" CornerRadius="16" Padding="20" MaxWidth="300"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding ConfirmTitle}" FontSize="14" FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConfirmMessage}" FontSize="11.5"
                     Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Classes="ghost" Content="取消" Command="{Binding ConfirmCancelCommand}" />
            <Button Classes="primary" Content="确认" Command="{Binding ConfirmYesCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</Window>
