<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BD2ModManager.Gui.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <Color x:Key="SystemAccentColor">#2563EB</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="WindowBg" Color="#F4F8FF" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BlueBorder" Color="#DBEAFE" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1E293B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#64748B" />
    <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="TrackOff" Color="#CBD5E1" />
    <SolidColorBrush x:Key="PillBg" Color="#F7FAFF" />
    <SolidColorBrush x:Key="PillBorder" Color="#DBEAFE" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />

    <LinearGradientBrush x:Key="ShellGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#F7FBFF" Offset="0" />
      <GradientStop Color="#EEF5FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PowerGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#3B82F6" Offset="0" />
      <GradientStop Color="#2563EB" Offset="1" />
    </LinearGradientBrush>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Noto Sans CJK SC, Inter, sans-serif" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Noto Sans Mono, monospace" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- 自定义窗口按钮 -->
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.window-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EAF2FF" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Button.window-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="Foreground" Value="#DC2626" />
    </Style>

    <!-- 底部胶囊 -->
    <Style Selector="Button.pill">
      <Setter Property="Background" Value="{StaticResource PillBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource PillBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="BorderBrush" Value="#BFDBFE" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- 中央电源按钮只负责内容和悬停，不画自己的背景 -->
    <Style Selector="Button.power">
      <Setter Property="Width" Value="112" />
      <Setter Property="Height" Value="112" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="56" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.power:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.94" />
    </Style>
    <Style Selector="Button.power:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.power:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- 次要按钮 -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- 主按钮 -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- 文字按钮 -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
    </Style>

    <!-- 日志 -->
    <Style Selector="ListBox.log-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Noto Sans Mono, monospace" />
      <Setter Property="FontSize" Value="10.5" />
    </Style>
    <Style Selector="ListBox.log-list ListBoxItem">
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBox.log-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.log-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#EFF6FF" />
    </Style>

    <!-- 大开关（兼容旧样式；当前主界面使用中央电源按钮） -->
    <Style Selector="ToggleButton.switch">
      <Setter Property="Width" Value="54" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border Name="Track" CornerRadius="15" Background="{StaticResource TrackOff}" />
            <Border Name="Knob" Width="22" Height="22" CornerRadius="11" Background="White"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
              <Border.BoxShadow>
                <BoxShadows>0 1 2 0 #33000000</BoxShadows>
              </Border.BoxShadow>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#Track">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#Knob">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="ToggleButton.switch:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </Application.Styles>
</Application>
