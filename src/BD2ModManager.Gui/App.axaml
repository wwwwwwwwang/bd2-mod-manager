<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BD2ModManager.Gui.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <Color x:Key="SystemAccentColor">#0F6CBD</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0B5A9E" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F1FB" />
    <SolidColorBrush x:Key="WindowBg" Color="#F3F3F3" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#E5E7EB" />
    <SolidColorBrush x:Key="BlueBorder" Color="#D6E7F7" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5F6368" />
    <SolidColorBrush x:Key="TextMuted" Color="#8A8A8A" />
    <SolidColorBrush x:Key="TrackOff" Color="#C7C7C7" />
    <SolidColorBrush x:Key="PillBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PillBorder" Color="#E5E7EB" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#107C10" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E6F4EA" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="LineBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#E8F1FB" />

    <LinearGradientBrush x:Key="ShellGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#F7FBFF" Offset="0" />
      <GradientStop Color="#EEF5FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PowerGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#3B82F6" Offset="0" />
      <GradientStop Color="#2563EB" Offset="1" />
    </LinearGradientBrush>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Noto Sans CJK SC, Inter, sans-serif" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="22" />
    </Style>

    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="TextBlock.page-subtitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,5" />
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="#3B3B3B" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F0F0F0" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{StaticResource NavActiveBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource NavActiveBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Noto Sans Mono, monospace" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- 自定义窗口按钮 -->
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.window-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EAF2FF" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Button.window-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="Foreground" Value="#DC2626" />
    </Style>

    <!-- 底部胶囊 -->
    <Style Selector="Button.pill">
      <Setter Property="Background" Value="{StaticResource PillBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource PillBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EFF6FF" />
      <Setter Property="BorderBrush" Value="#BFDBFE" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- 中央电源按钮只负责内容和悬停，不画自己的背景 -->
    <Style Selector="Button.power">
      <Setter Property="Width" Value="112" />
      <Setter Property="Height" Value="112" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="56" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.power:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.94" />
    </Style>
    <Style Selector="Button.power:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.power:disabled">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- 次要按钮 -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- 主按钮 -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- 文字按钮 -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
    </Style>

    <!-- 日志 -->
    <Style Selector="ListBox.log-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Noto Sans Mono, monospace" />
      <Setter Property="FontSize" Value="10.5" />
    </Style>
    <Style Selector="ListBox.log-list ListBoxItem">
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBox.log-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.log-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#EFF6FF" />
    </Style>

    <!-- 大开关（兼容旧样式；当前主界面使用中央电源按钮） -->
    <Style Selector="ToggleButton.switch">
      <Setter Property="Width" Value="54" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border Name="Track" CornerRadius="15" Background="{StaticResource TrackOff}" />
            <Border Name="Knob" Width="22" Height="22" CornerRadius="11" Background="White"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#Track">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#Knob">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="ToggleButton.switch:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- 弹层内的分组区块 -->
    <Style Selector="Border.section">
      <Setter Property="Background" Value="#FAFAFA" />
      <Setter Property="BorderBrush" Value="#E8E8E8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E2E2E2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="0 18 48 0 #26000000" />
    </Style>

    <Style Selector="TextBlock.sheet-title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style Selector="TextBlock.section-heading">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#3B3B3B" />
    </Style>

    <Style Selector="Border.badge-risk">
      <Setter Property="Background" Value="#FFF4E5" />
      <Setter Property="BorderBrush" Value="#F2C88E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="Border.badge-risk TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="#8A4B00" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EFEFEF" />
    </Style>
  </Application.Styles>
</Application>
