# ---- 构建产物 ----
bin/
obj/
out/
out-*/
publish/

# dist 是发布产物（65 MB 自包含 exe），不进版本库，走 GitHub Release
dist/

# 构建时嵌进图形界面的 loader 包与解锁插件，都由脚本现生成
src/BD2ModManager.Gui/Assets/bd2-loader.zip
src/BD2ModManager.Gui/Assets/BD2SkinUnlock.dll

# 插件编译用的引用程序集（从 loader 包里拆，scripts/prepare_refs.py）
refs/

# ---- .NET / Visual Studio / Rider ----
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.DotSettings.user

# ---- 本地工具与日志 ----
*.log
*.tmp
*.bak
~$*

# ---- 上游发行包缓存（scripts/package_loader.py）----
.cache/

# ---- IDE / agent 工作区数据（不属于项目源码）----
.workbuddy/

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini
