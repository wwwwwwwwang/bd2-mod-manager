<Project>

  <!--
    全仓库统一的程序集元数据。
    放在根目录，src/ 下所有项目（含将来的 GUI）自动继承，无需在各自 csproj 里重复。
    项目自身 csproj 中的同名属性会覆盖这里的值。
  -->
  <PropertyGroup>
    <!-- 版本：0.1 命令行，0.2 图形界面，0.3 第三方组件，0.4 自研解锁插件，0.4.1 残留清理，0.4.2 开关状态修正，0.4.3 残留判定与日志区，0.4.4 布局修正，0.4.5 内容区裁切，0.4.6 日志行高，0.4.7 解锁插件功能对齐，0.4.8 插件真正生效（Awake 挂补丁 + 渲染回调驱动），0.4.9 清理闭源插件痕迹，0.5.0 单文件发布（移除可选 ConfigurationManager），0.5.1 未启用 loader 时禁用组件安装，0.6.0 一键解锁（开关自动安装 loader 与解锁插件），0.7.0 蓝白小组件 UI（环形开关 + 目录/日志抽屉） -->
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>

    <!-- 署名：燧人氏，取「带来火种的人」之意 -->
    <Authors>燧人氏</Authors>
    <Company>燧人氏</Company>
    <Product>BD2ModManager</Product>
    <Copyright>Copyright (c) 2026 燧人氏</Copyright>
  </PropertyGroup>

</Project>
